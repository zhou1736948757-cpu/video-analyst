{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TemporalEvents",
  "description": "Timeline events from fine analysis. timestamps must be within media duration; unknown events carry unresolved=true (hard rule 12).",
  "type": "object",
  "additionalProperties": false,
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "timestamp", "kind", "description"],
        "properties": {
          "event_id": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "number", "minimum": 0 },
          "kind": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "source_batch_ids": { "type": "array", "items": { "type": "string" } },
          "evidence_frame_ids": { "type": "array", "items": { "type": "string" } },
          "unresolved": { "type": "boolean" },
          "unresolved_notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}