{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VideoStructure",
  "description": "Whole-video structural map from coarse analysis. Evidence must reference real coarse batches/frames (hard rule 9).",
  "type": "object",
  "additionalProperties": false,
  "required": ["structure_type", "segments", "notes", "unknowns"],
  "properties": {
    "structure_type": { "type": "string", "minLength": 1 },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "start", "end", "description"],
        "properties": {
          "segment_id": { "type": "string", "minLength": 1 },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "kind": { "type": "string" },
          "description": { "type": "string", "minLength": 1 },
          "source_batch_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "evidence_frame_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "unresolved": { "type": "boolean" },
          "unresolved_notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "notes": { "type": "string" },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}